<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200" fill="none">
  <!-- Thân áo Áo Dài Cách Tân Nữ - Phẳng, trơn nhẵn toàn bộ ngực và thân trước, không khuy nổi, không vạt chéo -->
  <g id="ao-dai-cach-tan">
    <!-- Cổ áo tròn thanh nhã viền vàng ánh kim -->
    <ellipse cx="100" cy="38" rx="16" ry="8" fill="#10B981" stroke="#FDE047" stroke-width="2"/>
    
    <!-- Hai tay áo thanh thoát buông dài -->
    <path d="M84 42 L42 108 L58 114 L88 70 Z" fill="#059669" stroke="#047857" stroke-width="1.5"/>
    <path d="M116 42 L158 108 L142 114 L112 70 Z" fill="#059669" stroke="#047857" stroke-width="1.5"/>
    
    <!-- Tà áo sau rủ mềm mại -->
    <path d="M82 44 L118 44 L138 182 L62 182 Z" fill="#047857" opacity="0.85"/>
    
    <!-- Tà áo trước phẳng, trơn nhẵn toàn bộ, không hàng khuy, không đường may vạt chéo -->
    <path d="M84 42 L116 42 L132 178 L68 178 Z" fill="#10B981" stroke="#FFFFFF" stroke-width="1.5"/>
    
    <!-- Giày cao gót mũi nhọn thanh mảnh tinh tế đi kèm ở chân -->
    <g id="giay-cao-got" transform="translate(0, 10)">
      <rect x="88" y="172" width="2" height="7" rx="0.5" fill="#18181B"/>
      <path d="M86 172 Q91 173 95 172 L101 175 Q98 178 92 177 L86 174 Z" fill="#18181B"/>
      <rect x="106" y="172" width="2" height="7" rx="0.5" fill="#18181B"/>
      <path d="M104 172 Q109 173 113 172 L119 175 Q116 178 110 177 L104 174 Z" fill="#18181B"/>
    </g>
  </g>
</svg>
